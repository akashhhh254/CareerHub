# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Any long random string works. You can generate one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
SECRET_KEY=change_this_to_a_random_string

# Optional. If not set, the app falls back to a local SQLite file
# (career_hub.db) automatically, so you can run the project without any
# database setup. Set this to your TiDB/MySQL connection string to use
# TiDB Cloud instead, e.g.:
# DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@HOST:4000/DBNAME
DATABASE_URL=
